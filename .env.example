# Spring Boot database connection
# Local Docker defaults:
DB_URL=jdbc:postgresql://localhost:5432/qlapm_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Prisma connection
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qlapm_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/qlapm_db?schema=public

# Supabase example:
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=<your-database-password>
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# Keep secrets only in your local .env / deployment environment. Never commit real passwords.

JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-256-bits-please
JWT_EXPIRATION_MS=86400000
